# Tender API — copy to apps/api/.env and fill in.
# Local dev uses SQLite (no DB server needed):
DATABASE_URL="file:./dev.db"

API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# ── PayPal (sandbox) — from https://developer.paypal.com ──
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ── LLM (OpenAI-compatible: OpenRouter or Groq) ───────────
# Set LLM_PROVIDER to "groq" or "openrouter" (or "none" for the deterministic
# negotiation engine). Groq is free/fast; a known-good model is below.
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# mock = no external PayPal calls (fully working demo).
# live = real PayPal sandbox API calls (requires client id/secret; payouts also
#        require the sandbox business account to be funded — see docs/06).
TENDER_MODE=mock
