# Tender — environment variables (copy to .env and fill in)
# NEVER commit your real .env file.

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/tender

# ── PayPal (sandbox) ─────────────────────────────────────
# From https://developer.paypal.com → Apps & Credentials (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ── LLM provider (choose one) ────────────────────────────
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── App ──────────────────────────────────────────────────
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
